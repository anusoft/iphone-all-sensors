# Fastfile — App Store Connect automation for "All Sensors" (com.1moby.allsensors)
#
# Auth: App Store Connect API key (.p8). Configure via environment variables
# (do NOT hardcode the issuer/key id in this committed file):
#
#   export ASC_KEY_ID=Y7U2DJCZQK
#   export ASC_ISSUER_ID=<your issuer id>
#   # optional; defaults to ~/.appstoreconnect/private_keys/AuthKey_$ASC_KEY_ID.p8
#   export ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_Y7U2DJCZQK.p8
#
# See docs/appstore/12-appstore-connect-and-fastlane.md for the full workflow.
# NOTE: the app record itself must be created once in the App Store Connect UI —
# the API cannot create apps. After that, these lanes are hands-off.

default_platform(:ios)

# Builds the App Store Connect API key token object from the environment.
def asc_api_key
  key_id = ENV.fetch("ASC_KEY_ID") { UI.user_error!("Set ASC_KEY_ID (your .p8 key id)") }
  issuer = ENV.fetch("ASC_ISSUER_ID") { UI.user_error!("Set ASC_ISSUER_ID (your issuer id)") }
  key_path = ENV["ASC_KEY_PATH"] || File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  UI.user_error!("Key not found at #{key_path}") unless File.exist?(key_path)
  app_store_connect_api_key(key_id: key_id, issuer_id: issuer, key_filepath: key_path, in_house: false)
end

platform :ios do
  desc "Push text metadata only (no binary, no screenshots)"
  lane :metadata do
    deliver(api_key: asc_api_key, skip_screenshots: true, run_precheck_before_submit: false)
  end

  desc "Stage + upload screenshots only"
  lane :screenshots do
    prepare_screenshots
    deliver(api_key: asc_api_key, skip_metadata: true, run_precheck_before_submit: false)
  end

  desc "Push the full store listing: metadata + screenshots (still no binary)"
  lane :store_listing do
    prepare_screenshots
    deliver(api_key: asc_api_key, run_precheck_before_submit: false)
  end

  # Copies the generated App Store screenshots into fastlane's expected
  # <screenshots_path>/en-US folder. deliver auto-detects device class by image
  # dimensions (iPhone 6.9" = 1320x2868, iPad 13" = 2064x2752), so we only ship
  # the 5 marketing pages per device and skip the numbered Show-Off pipeline assets.
  desc "Stage generated screenshots for deliver"
  private_lane :prepare_screenshots do
    # Anchor to the repo root (parent of this fastlane/ dir) so paths don't depend
    # on fastlane's working directory.
    repo = File.expand_path("..", __dir__)
    dest = File.join(repo, "fastlane", "screenshots", "en-US")
    FileUtils.rm_rf(dest)
    FileUtils.mkdir_p(dest)
    staged = 0
    %w[iphone-6.9 ipad-13].each do |slot|
      Dir.glob(File.join(repo, "screenshots", slot, "*.png")).sort.each do |src|
        base = File.basename(src)
        next if base =~ /\A\d/ # skip 01-*.png … (Show-Off clean captures)
        FileUtils.cp(src, File.join(dest, "#{slot}-#{base}"))
        staged += 1
      end
    end
    UI.user_error!("No screenshots staged — check screenshots/iphone-6.9 and ipad-13") if staged.zero?
    UI.success("Staged #{staged} App Store screenshots into #{dest}")
  end
end
